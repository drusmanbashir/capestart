#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENT_CMD="$ROOT_DIR/agent"

if [[ ! -x "$AGENT_CMD" ]]; then
  echo "Error: expected executable $AGENT_CMD"
  exit 1
fi

show_menu() {
  cat <<'EOM'
Agent CLI Menu
1. Show agent help
2. Init SBH dataset folder
3. Exit
EOM
}

while true; do
  show_menu
  read -r -p "Choose an option [1-3]: " choice

  case "$choice" in
    1)
      "$AGENT_CMD" help
      ;;
    2)
      read -r -p "Folder name: " folder_name
      read -r -p "Count (default 100): " count
      if [[ -z "${count}" ]]; then
        "$AGENT_CMD" init-sbh "$folder_name"
      else
        "$AGENT_CMD" init-sbh "$folder_name" "$count"
      fi
      ;;
    3)
      echo "Exiting agent-cli."
      exit 0
      ;;
    *)
      echo "Invalid option. Please choose 1, 2, or 3."
      ;;
  esac

  echo
done
